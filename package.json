{
  "name": "beatform",
  "private": true,
  "version": "2.108.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:gpu": "node scripts/gpu-pixel-matrix.mjs",
    "test:gpu:update": "node scripts/gpu-pixel-matrix.mjs --update",
    "build:guide": "vitest run src/ui/guideSync.test.ts -u",
    "test:loopback": "node scripts/loopback-smoke.mjs",
    "test:loopback:built": "node scripts/loopback-smoke.mjs --built",
    "test:loopback:built:30": "node scripts/loopback-smoke.mjs --built --fps=30",
    "test:lyrics": "node scripts/lyrics-e2e.mjs",
    "test:lyrics:quick": "node scripts/lyrics-e2e.mjs --skip-madness",
    "test:shadertoy:built": "node scripts/shadertoy-smoke.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "mediabunny": "^1.56.2",
    "music-metadata": "^11.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
