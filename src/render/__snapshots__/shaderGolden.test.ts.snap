  {
    "default": 0,
    "key": "sunRays",
  },
  {
    "default": 0.3,
    "key": "sunY",
  },
  {
    "default": 0,
    "key": "sunX",
  },
  {
    "default": 0.7,
    "key": "gridScale",
  },
  {
    "default": 0.5,
    "key": "horizonY",
  },
  {
    "default": 0.6,
    "key": "scan",
