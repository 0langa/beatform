  "meta": {
    "name": "Deep Current",
    "author": "Beatform",
    "license": "CC0-1.0",
    "description": "Bioluminescent folds a long way under the surface. Nothing strikes: the bass swells and takes a second and a half to let go, the tide glows in over two bars, and every section change turns the water a different colour.",
