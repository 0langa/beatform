  "meta": {
    "name": "Cold Open",
    "author": "Beatform",
    "license": "CC0-1.0",
    "description": "A single amber trace on a broadcast reticle, with your title and artist set as a hard editorial lockup. Twelve seconds of standby, then a glitch cut into the full instrument.",
    "bpmHint": [
      70,
      130
    ]
  },
